{
  "name": "hergame",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "scrape": "cd scraper && python soccerdonna_scraper.py",
